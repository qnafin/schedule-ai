{
  "name": "schedule-ai",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "npx tsx --env-file=.env src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "mcp": "node --env-file=.env ./node_modules/.bin/fastmcp run fsrc/mcp/server.ts",
    "mcp:inspect": "node --env-file=.env ./node_modules/.bin/fastmcp inspect --file fsrc/mcp/server.ts",
    "mcp:dev": "node --env-file=.env ./node_modules/.bin/fastmcp dev inspector fsrc/mcp/server.ts ",
    "mcp:http": "node --env-file=.env ./node_modules/.bin/fastmcp run fsrc/mcp/server.ts --transport http --port 3000",
    "daily": "npx tsx fsrc/cli/daily.ts --dates 2026-09-01,2026-09-02",
    "bot": "npx tsx --env-file=.env fsrc/bot/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prefecthq/fastmcp-ts": "^1.7.2",
    "google-auth-library": "^11.1.0",
    "google-spreadsheet": "^5.3.0",
    "vk-io": "^4.10.1",
    "zod": "^4.6.5"
  }
}
